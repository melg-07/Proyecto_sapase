# ============================================================
#  SAPASE – Variables de entorno
#
#  Para desarrollo local:
#    Copia este archivo como  .env  en la RAIZ del proyecto
#    (junto a package.json), NO dentro de backend/
#
#  Para Render:
#    Configura estas variables en el dashboard:
#    Settings > Environment > Add Environment Variable
#    (NO uses .env en produccion, solo variables del dashboard)
# ============================================================

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_PASSWORD_AQUI
DB_NAME=sapase_db

# JWT – usa una cadena larga y aleatoria en produccion
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura_2025
JWT_EXPIRES=8h

# Puerto – Render lo asigna automaticamente, no lo pongas en Render
PORT=3001
